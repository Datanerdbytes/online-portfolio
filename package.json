{
  "name": "online-resume",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "prepare": "husky",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "test:web": "npm test --workspace=apps/web",
    "format:check:pr": "node scripts/check-format.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.5"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6",
    "zod": "^4.6.7",
    "better-auth": "1.7.7",
    "@react-email/render": "2.2.0",
    "minimatch": "11.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.2"
}
