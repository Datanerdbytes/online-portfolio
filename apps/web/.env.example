# Frontend environment variables (loaded from apps/web/)
# Copy this file to .env.local and adjust as needed. Do not commit .env.local.
# API_BASE_URL and ADMIN_WEB_ORIGIN are server-side only; do not expose via NEXT_PUBLIC_.

API_BASE_URL=http://localhost:8000
ADMIN_WEB_ORIGIN=http://localhost:3000

# ADMIN_WEB_ORIGIN must exactly match scheme, host, and port (no trailing slash).
# Production requires an HTTPS origin and uses a Secure __Host- cookie.
# Missing/invalid origin disables admin routes; public browsing still works.
