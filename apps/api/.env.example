# Backend environment variables (loaded from apps/api/)
# Copy this file to .env and adjust as needed. Do not commit .env.

DATABASE_URL=postgresql+psycopg://resume:resume@localhost:5432/resume
API_HOST=0.0.0.0
API_PORT=8000
# Public URL of the Next.js frontend, reported by GET / on the API.
WEB_APP_URL=http://localhost:3000

# Avatar storage. MEDIA_ROOT holds the uploaded profile photo; the directory is
# created on demand and is not durable across a container redeploy.
# MEDIA_ROOT=./media
# Maximum accepted avatar size in bytes (2 MiB).
# MAX_AVATAR_BYTES=2097152
# Set to database on stateless hosts such as Vercel. Run Alembic first.
MEDIA_STORAGE=local
# Use external with Neon's pooled URL; local keeps SQLAlchemy's normal pool.
DATABASE_POOL_MODE=local

# Neon Managed Better Auth URL for the same project/branch as your app.
# Copy from the Neon Console; the API verifies provider JWTs using its public JWKS.
NEON_AUTH_BASE_URL=
# Default public portfolio (the existing content preserved by migration).
PUBLIC_PORTFOLIO_USER_ID=00000000-0000-0000-0000-000000000001
# Optional: bind the existing portfolio to this verified Neon user ID, before first editor use.
# Set deliberately from the Neon Console; never use email or a request-supplied ID.
LEGACY_NEON_USER_ID=
# The old API_ACCESS_SECRET / OWNER_* / LOGIN_RATE_LIMIT_STORAGE variables are retired.

# GitHub README sync (dynamic project documentation)
# Create a Personal Access Token at https://github.com/settings/tokens
# No special scopes needed for public repositories
GITHUB_PAT=
GITHUB_USERNAME=

# Optional resume import: keep disabled until synthetic NVIDIA evaluation passes.
# No documents or extracted proposals are stored by the importer.
RESUME_IMPORT_ENABLED=false
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# NVIDIA_API_KEY=  # Configure securely; never commit a real key.

# Local document reading only; unavailable on Vercel. Does not call NVIDIA.
RESUME_IMPORT_LOCAL_PREVIEW=false
