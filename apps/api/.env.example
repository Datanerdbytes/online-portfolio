# Backend environment variables (loaded from apps/api/)
# Copy this file to .env and adjust as needed. Do not commit .env.

DATABASE_URL=postgresql+psycopg://resume:resume@localhost:5432/resume
API_HOST=0.0.0.0
API_PORT=8000
# Public URL of the Next.js frontend, reported by GET / on the API.
WEB_APP_URL=http://localhost:3000

# Optional owner administration: all four values must be provisioned together.
# Leave blank for public-only operation. Never commit real values.
# Generate API_ACCESS_SECRET from at least 32 random bytes.
API_ACCESS_SECRET=
OWNER_ID=
OWNER_USERNAME=
# Provision an Argon2id password hash out of band; never put plaintext here.
OWNER_PASSWORD_HASH=
# Initial login limiter is process-local: deploy only one worker/replica.
